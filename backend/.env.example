DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vyapaarpilot1

# AI Provider Settings ("groq", "gemini", "mock")
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Alternative Gemini Provider
GEMINI_API_KEY=

# Voice / Multimodal Configuration
STT_PROVIDER=groq
TTS_PROVIDER=mock
VOICE_MAX_UPLOAD_MB=15.0
VOICE_DEFAULT_LANGUAGE=hinglish

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*
