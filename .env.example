# VyapaarPilot Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# ---- Database ----
# MySQL (primary)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vyapaarpilot1

# Override with full connection string (optional - takes precedence over DB_* vars)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vyapaarpilot1
# DATABASE_URL=sqlite:///./vyapaarpilot.db

# ---- AI Provider ----
# Options: groq, gemini, mock
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- Voice / Multimodal ----
# STT Options: assemblyai, groq, gemini, mock
# TTS Options: assemblyai, edge_tts, mock
ASSEMBLYAI_API_KEY=
STT_PROVIDER=assemblyai
TTS_PROVIDER=assemblyai
VOICE_MAX_UPLOAD_MB=15.0
VOICE_DEFAULT_LANGUAGE=hinglish

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,*
