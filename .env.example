# VyapaarPilot Environment Configuration Template

# Database Configuration
# PostgreSQL (Primary)
DATABASE_URL=postgresql://vyapaar_user:vyapaar_pass@localhost:5432/vyapaarpilot
# SQLite Fallback (Alternative for local dev)
# DATABASE_URL=sqlite:///./vyapaarpilot.db

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,*

# Environment Mode
ENVIRONMENT=development
DEBUG=True
